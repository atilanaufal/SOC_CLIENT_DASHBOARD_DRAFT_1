# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION CONFIGURATION)
# ==============================================================================
# INSTRUCTIONS: Copy this file to '.env.local' or '.env.production' and fill in
# the production secrets and server endpoints before launching the application.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Better Auth & Security
# Generate a strong 32+ byte random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=your_production_secret_key_change_me_immediately
BETTER_AUTH_URL=https://dashboard.example.ac.id

# Next.js Public Application URL
NEXT_PUBLIC_APP_URL=https://dashboard.example.ac.id

# MySQL (Auth & Multi-Tenant Database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=auth_db
MYSQL_USER=auth_user
MYSQL_PASSWORD=change_this_mysql_password
MYSQL_SSL=false

# Redis (Real-Time Cache & Rate Limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=2000

# MongoDB (Historical Multi-Tenant Data Store)
# Direct connection URI or cluster URI:
# Standard format: mongodb://username:password@host:port/?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017
# Secondary fallback hosts (comma-separated):
MONGODB_FALLBACK_HOSTS=

# Wazuh Server API (Endpoint & Agent Security Fleet)
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_HOST=127.0.0.1
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change_this_wazuh_password
# Optional: Path to custom CA certificate for strict TLS validation
WAZUH_API_CA_PATH=
# Set to 'false' only in airgapped environments with self-signed certificates
WAZUH_API_STRICT_SSL=false

# Wazuh Indexer / OpenSearch (Alert Log Aggregator)
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change_this_opensearch_password

# DFIR-IRIS PostgreSQL Database
DFIR_IRIS_HOST=127.0.0.1
DFIR_IRIS_PORT=5432
DFIR_IRIS_DB=iris_db
DFIR_IRIS_USER=iris_user
DFIR_IRIS_PASSWORD=change_this_iris_password
